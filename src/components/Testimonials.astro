---
// Shows only when at least one testimonial has been added in the dashboard.
import { getTestimonials } from '../lib/data';
const items = await getTestimonials();
---
{items.length > 0 && (
  <section class="section bg-sand testimonials" aria-label="Kind words">
    <div class="narrow center">
      <p class="eyebrow">Kind words</p>
      <div class="track" tabindex="0" aria-label="Testimonials, scroll sideways for more">
        {items.map((t) => (
          <figure class="slide">
            <blockquote>
              <p>{t.data.quote}</p>
            </blockquote>
            <figcaption>— {t.data.name}{t.data.session && <span>, {t.data.session}</span>}</figcaption>
          </figure>
        ))}
      </div>
      {items.length > 1 && (
        <div class="controls">
          <button type="button" class="prev" aria-label="Previous testimonial">
            <svg width="28" height="14" viewBox="0 0 28 14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M27 7H1M7 1L1 7l6 6"/></svg>
          </button>
          <button type="button" class="next" aria-label="Next testimonial">
            <svg width="28" height="14" viewBox="0 0 28 14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M1 7h26M21 1l6 6-6 6"/></svg>
          </button>
        </div>
      )}
    </div>
  </section>
)}

<script>
  document.querySelectorAll('.testimonials').forEach((sec) => {
    const track = sec.querySelector<HTMLElement>('.track');
    if (!track) return;
    const go = (dir: number) => {
      const w = track.clientWidth;
      const max = track.scrollWidth - w;
      let next = track.scrollLeft + dir * w;
      if (next > max + 2) next = 0;
      if (next < -2) next = max;
      track.scrollTo({ left: next, behavior: 'smooth' });
    };
    sec.querySelector('.prev')?.addEventListener('click', () => go(-1));
    sec.querySelector('.next')?.addEventListener('click', () => go(1));
  });
</script>

<style>
  .track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    margin-top: 28px;
  }
  .track::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 100%; scroll-snap-align: center; margin: 0; padding: 0 8px; }
  blockquote { margin: 0; }
  blockquote p {
    font-family: var(--serif); font-size: clamp(24px, 2.8vw, 36px); line-height: 1.35; margin: 0;
  }
  figcaption { margin-top: 24px; font-size: 12px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); }
  .controls { display: flex; justify-content: center; gap: 24px; margin-top: 28px; }
  .controls button { width: 48px; height: 48px; display: grid; place-items: center; background: none; border: 0; color: var(--espresso); cursor: pointer; }
  .controls button:hover { color: var(--mocha); }
</style>
