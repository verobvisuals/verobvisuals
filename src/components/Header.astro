---
import Wordmark from './Wordmark.astro';
import { getSettings } from '../lib/data';

interface Props { transparent?: boolean; }
const { transparent = false } = Astro.props;
const s = await getSettings();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const left = [
  { href: '/about', label: 'About' },
  { href: '/portfolio', label: 'Portfolio' },
];
const right = [
  { href: '/sessions', label: 'Sessions' },
  { href: '/contact', label: 'Contact' },
];
const all = [{ href: '/', label: 'Home' }, ...left, ...right];
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<div class:list={['top', { transparent }]}>
{s.announcement && (
  <div class="announce">
    <p>{s.announcement}</p>
    <a href="/contact">Inquire now</a>
  </div>
)}
<header class:list={['site-header', { transparent }]}>
  <div class="bar">
    <nav class="nav nav-left" aria-label="Primary">
      {left.map((l) => <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <a href="/" class="brand" aria-label={`${s.business_name} home`}><Wordmark /></a>
    <nav class="nav nav-right" aria-label="Secondary">
      {right.map((l) => <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="visually-hidden">Menu</span>
      <svg width="26" height="14" viewBox="0 0 26 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M0 1h26M0 7h26M0 13h26"/></svg>
    </button>
  </div>
  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Mobile">
      {all.map((l) => <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
  </div>
</header>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu');
  const header = document.querySelector('.site-header');
  if (btn && menu && header) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      header.classList.toggle('menu-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => set(menu.hidden));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>

<style>
  .announce {
    background: var(--taupe); color: var(--espresso);
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px 20px;
    padding: 9px var(--gutter); text-align: center;
    font-size: 11px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase;
  }
  .announce p { margin: 0; }
  .announce a { color: var(--espresso); opacity: .75; }

  .site-header { position: relative; z-index: 20; background: var(--white); border-bottom: 1px solid var(--line); }
  .top.transparent { position: absolute; top: 0; left: 0; right: 0; z-index: 20; }
  .site-header.transparent { background: transparent; border-color: transparent; color: var(--white); }
  .site-header.menu-open { position: fixed; top: 0; left: 0; right: 0; background: var(--white); color: var(--espresso); border-color: var(--line); }
  .bar {
    width: min(100% - 2 * var(--gutter), var(--max)); margin-inline: auto;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px;
    min-height: 92px;
  }
  .brand { text-decoration: none; color: inherit; display: flex; justify-content: center; }
  .nav { display: flex; gap: clamp(24px, 4vw, 56px); }
  .nav-left { justify-content: flex-end; }
  .nav-right { justify-content: flex-start; }
  .nav a, .mobile-menu a {
    font-size: 12px; font-weight: 500; letter-spacing: 0.26em; text-transform: uppercase;
    text-decoration: none; padding: 12px 0; position: relative;
  }
  .nav a::after {
    content: ''; position: absolute; left: 0; right: 0.26em; bottom: 6px; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .3s;
  }
  .nav a:hover::after, .nav a[aria-current='page']::after { transform: scaleX(1); }
  .menu-btn { display: none; }

  @media (max-width: 899px) {
    .bar { grid-template-columns: 1fr auto; min-height: 72px; }
    .nav { display: none; }
    .brand { justify-content: flex-start; }
    .menu-btn {
      display: inline-flex; align-items: center; justify-content: center;
      width: 48px; height: 48px; margin-right: -12px;
      background: none; border: 0; color: inherit; cursor: pointer;
    }
    .mobile-menu {
      position: fixed; inset: 72px 0 0; background: var(--white); color: var(--espresso);
      padding: 32px var(--gutter);
    }
    .mobile-menu nav { display: flex; flex-direction: column; }
    .mobile-menu a {
      font-family: var(--serif); font-size: 30px; font-weight: 400; letter-spacing: 0.08em;
      padding: 14px 0; border-bottom: 1px solid var(--line);
    }
    .mobile-menu a[aria-current='page'] { font-style: italic; }
  }
</style>
